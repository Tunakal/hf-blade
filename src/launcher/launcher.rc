#include <windows.h>
#include <commctrl.h>
#include "resource.h"

1 24 "launcher.manifest"

// Optional app icon: build.bat defines HAVE_ICON when src\launcher\launcher.ico exists.
#ifdef HAVE_ICON
1 ICON "launcher.ico"
#endif

// Built-in Play-page banner: Tunahan's own Raiden drawing, tinted (same license as the project).
2 RCDATA "banner.jpg"

// Borderless window. This template only lists the controls (in tab order); launcher.cpp (BuildLayout)
// sizes the window and positions every control, and paints the sidebar, cards and descriptions.
// Toggles, buttons, sidebar rows and combo boxes are owner-drawn. Labels use SS_NOTIFY for tooltips.
#define CB_STYLE CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
#define LBL SS_NOTIFY | SS_CENTERIMAGE
#define BTN BS_OWNERDRAW | WS_TABSTOP

IDD_MAIN DIALOGEX 0, 0, 320, 240
STYLE DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_SYSMENU | WS_MINIMIZEBOX
EXSTYLE WS_EX_APPWINDOW
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    // Sidebar pages
    CONTROL         "Play", IDC_NAV0, "Button", BTN, 0, 0, 10, 10
    CONTROL         "Gameplay", IDC_NAV0 + 1, "Button", BTN, 0, 0, 10, 10
    CONTROL         "Display", IDC_NAV0 + 2, "Button", BTN, 0, 0, 10, 10
    CONTROL         "Photo Mode", IDC_NAV0 + 3, "Button", BTN, 0, 0, 10, 10
    CONTROL         "Cheats", IDC_NAV0 + 4, "Button", BTN, 0, 0, 10, 10
    CONTROL         "Launcher", IDC_NAV0 + 5, "Button", BTN, 0, 0, 10, 10
    CONTROL         "Log", IDC_NAV0 + 6, "Button", BTN, 0, 0, 10, 10
    CONTROL         "", IDC_MUTE, "Button", BTN, 0, 0, 10, 10
    CONTROL         "", IDC_XMIN, "Button", BS_OWNERDRAW, 0, 0, 10, 10
    CONTROL         "", IDC_XCLOSE, "Button", BS_OWNERDRAW, 0, 0, 10, 10

    // Play
    CONTROL         "Save && Play", IDC_PLAYBIG, "Button", BTN, 0, 0, 10, 10

    // Gameplay
    LTEXT           "Gameplay FPS", IDC_L_FPS, 0, 0, 10, 10, LBL
    COMBOBOX        IDC_FPS, 0, 0, 10, 10, CB_STYLE
    LTEXT           "Menu FPS", IDC_L_MENU, 0, 0, 10, 10, LBL
    COMBOBOX        IDC_MENUFPS, 0, 0, 10, 10, CB_STYLE
    CONTROL         "High frame rate patches", IDC_HFR, "Button", BTN, 0, 0, 10, 10
    CONTROL         "Button-mash QTE fix", IDC_QTE, "Button", BTN, 0, 0, 10, 10
    CONTROL         "Blade Mode fix", IDC_BLADE, "Button", BTN, 0, 0, 10, 10
    LTEXT           "QTE ease", IDC_L_EASE, 0, 0, 10, 10, LBL
    CONTROL         "", IDC_EASE, TRACKBAR_CLASS, TBS_HORZ | TBS_NOTICKS | WS_TABSTOP, 0, 0, 10, 10
    RTEXT           "60%", IDC_EASEVAL, 0, 0, 10, 10, SS_CENTERIMAGE
    CONTROL         "Quick weapon switch  (D-pad down)", IDC_WEAPONSW, "Button", BTN, 0, 0, 10, 10
    LTEXT           "Keep pieces of the last", IDC_L_PIECES, 0, 0, 10, 10, LBL
    COMBOBOX        IDC_KEEPCUTS, 0, 0, 10, 10, CB_STYLE
    LTEXT           "Keep bodies of the last", IDC_L_BODIES, 0, 0, 10, 10, LBL
    COMBOBOX        IDC_KEEPBODIES, 0, 0, 10, 10, CB_STYLE

    // Display
    LTEXT           "Render size", IDC_L_RES, 0, 0, 10, 10, LBL
    COMBOBOX        IDC_RES, 0, 0, 10, 10, CB_STYLE
    CONTROL         "Aspect-correct field of view", IDC_VERTPLUS, "Button", BTN, 0, 0, 10, 10
    CONTROL         "Supersampling  (NVIDIA / AMD GPU, may lower fps)", IDC_SUPERSAMPLE, "Button", BTN, 0, 0, 10, 10
    LTEXT           "Supersampling factor", IDC_L_SSFACTOR, 0, 0, 10, 10, LBL
    COMBOBOX        IDC_SSFACTOR, 0, 0, 10, 10, CB_STYLE
    LTEXT           "", IDC_RESINFO, 0, 0, 10, 10, SS_CENTERIMAGE
    LTEXT           "The mod replaces the game's 1920x1080 option. In the game's graphics settings, pick 1920x1080 and fullscreen; it is then rendered at the size chosen here, with no black bars.", IDC_RESNOTE, 0, 0, 10, 10

    // Photo Mode
    CONTROL         "Enable photo mode  (F10 in game)", IDC_PHOTO, "Button", BTN, 0, 0, 10, 10
    LTEXT           "CONTROLLER\n\nLeft stick\nRight stick\nLT / RT\nLB / RB\nD-pad up / down\nL3 (hold)\nY\nX", IDC_PHOTOPAD, 0, 0, 10, 10, SS_NOPREFIX
    LTEXT           "\n\nmove\nlook\ndown / up\nroll\nzoom in / out\nfaster\nreset\nHUD on / off", IDC_PHOTOPAD2, 0, 0, 10, 10, SS_NOPREFIX
    LTEXT           "KEYBOARD\n\nW A S D\nArrow keys\nCtrl / Space\nQ / E\nZ / X\nShift / Alt\nR\nH", IDC_PHOTOKB, 0, 0, 10, 10, SS_NOPREFIX
    LTEXT           "\n\nmove\nlook\ndown / up\nroll\nzoom in / out\nfaster / slower\nreset\nHUD on / off", IDC_PHOTOKB2, 0, 0, 10, 10, SS_NOPREFIX

    // Cheats
    CONTROL         "Infinite health", IDC_CH_HEALTH, "Button", BTN, 0, 0, 10, 10
    CONTROL         "Infinite fuel cells", IDC_CH_FUEL, "Button", BTN, 0, 0, 10, 10
    CONTROL         "Infinite Repair Units and Electrolyte packs", IDC_CH_ITEMS, "Button", BTN, 0, 0, 10, 10

    // Launcher
    LTEXT           "Opening animation", IDC_L_INTRO, 0, 0, 10, 10, LBL
    COMBOBOX        IDC_INTRO, 0, 0, 10, 10, CB_STYLE
    CONTROL         "Preview", IDC_PREVIEW, "Button", BTN, 0, 0, 10, 10
    CONTROL         "Sound effects", IDC_SOUND, "Button", BTN, 0, 0, 10, 10

    // Log
    CONTROL         "Refresh", IDC_LOGREFRESH, "Button", BTN, 0, 0, 10, 10
    CONTROL         "Open folder", IDC_LOGFOLDER, "Button", BTN, 0, 0, 10, 10
    CONTROL         "", IDC_LOGVIEW, "Edit", ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP, 0, 0, 10, 10

    // Bottom bar
    LTEXT           "", IDC_HINT, 0, 0, 10, 10, SS_CENTERIMAGE
    LTEXT           "", IDC_WARN, 0, 0, 10, 10, SS_CENTERIMAGE
    CONTROL         "Save", IDC_SAVE, "Button", BTN, 0, 0, 10, 10
    CONTROL         "Save && Play", IDC_PLAY, "Button", BTN, 0, 0, 10, 10
END
