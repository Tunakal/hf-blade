// Version information of the mod DLL (Properties > Details). See version.h.
#include <winres.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     HFB_VERSION_NUM
 PRODUCTVERSION  HFB_VERSION_NUM
 FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
 FILEFLAGS       0x0L
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_DLL
 FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "HF Blade (open source, " HFB_HOMEPAGE ")"
            VALUE "FileDescription",  "HF Blade: enhancement mod for METAL GEAR RISING: REVENGEANCE (DirectInput 8 proxy)"
            VALUE "FileVersion",      HFB_VERSION_STR
            VALUE "InternalName",     "dinput8"
            VALUE "LegalCopyright",   HFB_COPYRIGHT
            VALUE "OriginalFilename", "dinput8.dll"
            VALUE "ProductName",      "HF Blade"
            VALUE "ProductVersion",   HFB_VERSION_STR
            VALUE "Comments",         "Patches the game in memory only. Source: " HFB_HOMEPAGE
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
